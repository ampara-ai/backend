# OpenRouter — enruta automáticamente a Groq/Cerebras según disponibilidad
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-oss-120b

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ampara
MONGODB_COLLECTION_CHUNKS=chunks_collection

# Model Service (ONNX — embeddings BGE-M3 + reranker bge-reranker-v2-m3)
# Usar "mock" para desarrollo sin el servicio corriendo
MODEL_SERVICE_URL=http://model-service:8001
EMBEDDING_ENDPOINT=/embed
RERANKER_ENDPOINT=/rerank

# PostgreSQL — contenedor Docker "db"
# POSTGRES_PASSWORD va sin escapar; POSTGRES_DSN debe usar password URL-encoded.
POSTGRES_PASSWORD=<raw-db-password>
POSTGRES_DSN=postgresql://ampara:<url-encoded-password>@db:5432/ampara

# RAGAS evaluación por consulta (requiere POSTGRES_DSN configurado)
RAGAS_ENABLED=false
# Embeddings para el script batch (HuggingFace local, default: nomic)
RAGAS_EMBEDDINGS_MODEL=nomic-ai/nomic-embed-text-v1.5
# Embeddings para evaluación en tiempo real (API via OpenRouter)
RAGAS_REALTIME_EMBEDDINGS_MODEL=qwen/qwen3-embedding-8b

# JWT autenticación admin
JWT_SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga-en-produccion
JWT_EXPIRE_MINUTES=480

# App
APP_ENV=development
SESSION_MAX_MESSAGES=5
RERANKER_SCORE_THRESHOLD=0.5
