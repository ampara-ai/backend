# OpenRouter — el proveedor se fija en cada request (solo Groq, sin fallback,
# sin proveedores que guardan datos). LLM_PROVIDER_ONLY vacío = sin restricción.
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-oss-120b
LLM_PROVIDER_ONLY=groq
LLM_ALLOW_FALLBACKS=false
LLM_DATA_COLLECTION=deny

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ampara
MONGODB_COLLECTION_CHUNKS=chunks_collection

# Model Service (ONNX — embeddings BGE-M3 finetuneado/base)
# Usar "mock" para desarrollo sin el servicio corriendo
MODEL_SERVICE_URL=http://model-service:8001
EMBEDDING_ENDPOINT=/embed
EMBEDDING_BASE_ENDPOINT=/embed_base

# Reranker (bge-reranker-v2-m3) — NO se usa en el pipeline de producción
# (decisión tras el experimento de ablación: el embedding finetuneado solo
# rindió mejor). Solo lo usa scripts/eval_ablation.py (config hybrid_rerank).
RERANKER_ENDPOINT=/rerank

# PostgreSQL — contenedor Docker "db"
# POSTGRES_PASSWORD va sin escapar; POSTGRES_DSN debe usar password URL-encoded.
POSTGRES_PASSWORD=<raw-db-password>
POSTGRES_DSN=postgresql://ampara:<url-encoded-password>@db:5432/ampara

# RAGAS evaluación por consulta (requiere POSTGRES_DSN configurado)
RAGAS_ENABLED=false
# LLM juez (Faithfulness/Answer Relevancy), vía OpenRouter — usado por
# app/services/ragas_eval.py, scripts/eval_dataset_ragas.py y scripts/eval_ablation.py
RAGAS_LLM_MODEL=deepseek/deepseek-v4-flash
# Embeddings para el script batch (HuggingFace local, default: nomic)
RAGAS_EMBEDDINGS_MODEL=nomic-ai/nomic-embed-text-v1.5
# Embeddings para evaluación en tiempo real (API via OpenRouter)
RAGAS_REALTIME_EMBEDDINGS_MODEL=qwen/qwen3-embedding-8b

# JWT autenticación admin
JWT_SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga-en-produccion
JWT_EXPIRE_MINUTES=480

# Bootstrap del primer admin al arrancar — vacío = deshabilitado (crear manual
# con scripts/create_first_admin.py). Solo crea si no existe ningún admin aún.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# App
APP_ENV=development
SESSION_MAX_MESSAGES=5
# Minutos sin actividad tras los que se borra el historial de una sesión
SESSION_IDLE_TTL_MINUTES=15

# Umbral del reranker — NO se usa en producción (ver nota de RERANKER_ENDPOINT
# arriba), solo lo lee scripts/eval_ablation.py para su config hybrid_rerank.
RERANKER_SCORE_THRESHOLD=0.5

# Protección de costos durante la validación cualitativa (usuarios reales
# probando el chatbot)
MAX_QUERIES_PER_IP=10
MAX_MESSAGE_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=8192
